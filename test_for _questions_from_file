import json

with open("question_bank.json", "r", encoding="utf-8") as file:
    question_bank = json.load(file)

score = 0;
total_questions = len(question_bank)
for q in question_bank:
    print(f"Question : {q['question']}")
    print(f"Choices: {', '.join(q['choices'])}")
    user_answer = input("Your answer: ")
    user_input_stripper = user_answer.strip().lower()
    question_bank_answer = q['answer'].strip().lower()

    if user_input_stripper == question_bank_answer:
        print("Correct")
        score+=1
    else:
        print("Incorrect")

rounder = (score/total_questions*100)

print("Test score: ", score , "out of ", total_questions ," or ", (f"in percent: {rounder:.2f}"))

confirm = input("Do you want to add questions? ").strip().lower()

while confirm == "yes":
    new_question = input("Question: ")
    choices = []
    for i in range(1, 5):
        choice = input(f"Choice {i}: ")
        choices.append(choice)
    answer = input("Correct answer: ")
    new_dict = {"question": new_question, "choices": choices, "answer": answer}
    question_bank.append(new_dict)
    with open("question_bank.json", "w", encoding="utf-8") as file:
        json.dump(question_bank, file, indent=4)
    print("Question saved!")
    confirm = input("Add another question? ").strip().lower()
